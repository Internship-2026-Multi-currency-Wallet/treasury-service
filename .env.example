# Copy to .env for local runs outside docker-compose. Values below are local-only placeholders.
# Never commit a real .env file.

# HTTP port
PORT=3002
NODE_ENV=development

# Environment: local | staging | kvitka-uat | wisla-uat
# Prefixes all Redis channels/streams/queues (e.g. "staging:rate.tick").
APP_ENV=local

# MySQL: one database per service (treasury_service for this service)
DATABASE_URL=mysql://wallet:wallet@localhost:3306/treasury_service

# Redis: events (pub/sub, streams) and BullMQ
REDIS_URL=redis://localhost:6379

# Client this deployment serves: demo | kvitka | wisla
CLIENT=demo

# Process roles: GATEWAY (HTTP + GraphQL), WORKER (BullMQ processors) or GATEWAY,WORKER
ROLE=GATEWAY,WORKER

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: overrides the version shown by `health` (CI sets the git SHA)
APP_VERSION=

# Log level: fatal | error | warn | info | debug | trace | silent. JSON output; pretty with NODE_ENV=development
LOG_LEVEL=info

# Production deployments must provision the same private HS256 secret as wallet-core.
JWT_ISSUER=wallet-core
JWT_SECRET=local-only-jwt-secret-change-me-0123456789
